APP_NAME=Financial RAG API
APP_VERSION=0.1.0
APP_DESCRIPTION=A starter FastAPI service for a finance-focused RAG project.
API_V1_PREFIX=/api/v1
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DOCUMENTS_STORAGE_DIR=data/documents
DOCUMENTS_MAX_UPLOAD_SIZE_MB=25
DOCUMENTS_CHUNK_SIZE_BYTES=1048576
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120
DOCUMENT_CHUNK_PREVIEW_LIMIT=180
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=60
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=60
LLM_SYSTEM_PROMPT=You are a helpful finance-focused AI assistant. Answer clearly and avoid fabricating facts.
